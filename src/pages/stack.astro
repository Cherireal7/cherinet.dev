---
import BaseLayout from "../layouts/BaseLayout.astro";

const groups = [
  {
    title: "Editor & terminal",
    items: [
      { name: "VS Code", note: "Daily driver." },
      { name: "Windows Terminal + PowerShell", note: "Shell." },
    ],
  },
  {
    title: "Design",
    items: [
      { name: "Figma", note: "Tokens-first. Variables for theming. Auto-layout everywhere." },
    ],
  },
  {
    title: "Frontend / web",
    items: [
      { name: "TypeScript", note: "Default. Strict mode on." },
      { name: "Next.js (App Router)", note: "Most marketing + product work." },
      { name: "Astro", note: "Content-led sites (like this one)." },
      { name: "Tailwind v4", note: "Variables-first design system in CSS." },
      { name: "MDX", note: "Long-form content + components together." },
      { name: "Framer Motion + GSAP", note: "Motion — Framer for component-scoped, GSAP for timeline-heavy scroll." },
      { name: "MapLibre GL", note: "Coverage maps on the FIDA surfaces." },
    ],
  },
  {
    title: "Mobile",
    items: [
      { name: "Expo SDK 56", note: "New Architecture, CNG, EAS Updates." },
      { name: "React Native Reanimated", note: "Worklets for any non-trivial gesture." },
    ],
  },
  {
    title: "Backend / data",
    items: [
      { name: "Payload v3", note: "When the CMS needs to be the source of truth." },
      { name: "Fastify", note: "Tiny services. Type-safe end to end." },
      { name: "Drizzle + Neon", note: "Postgres without the operations." },
      { name: "Better Auth", note: "Pluggable, type-safe auth." },
      { name: "Prisma", note: "Where a mature client is easier than hand-rolling queries." },
    ],
  },
  {
    title: "Hosting & ops",
    items: [
      { name: "Vercel", note: "Most Next + Astro deploys." },
      { name: "Cloudflare R2", note: "Media storage for content-heavy sites." },
      { name: "EAS", note: "OTA + native builds for the FIDA apps." },
      { name: "Formsubmit", note: "Zero-backend forms on marketing sites." },
    ],
  },
  {
    title: "Hardware",
    items: [
      { name: "HP laptop, 14\"", note: "Main work machine." },
    ],
  },
];

---

<BaseLayout
  title="Stack & uses"
  description="The actual tools Cherinet Demeke uses to design, code, and ship."
  current="Stack"
>
  <!-- Hero -->
  <section class="px-6 pb-8 pt-28 md:px-10 md:pb-12 md:pt-32">
    <div class="mx-auto max-w-6xl">
      <p class="text-[11px] uppercase tracking-[0.18em] text-ink-subtle">/uses</p>
      <h1
        class="mt-4 max-w-4xl font-display font-medium leading-[1.05] tracking-[-0.03em] text-ink"
        style="font-size: var(--text-display-lg);"
      >
        The stack
        <span class="italic text-ink-muted">behind the work.</span>
      </h1>
      <p class="mt-5 max-w-2xl text-[15px] leading-relaxed text-ink-muted">
        Tools change. Principles don&rsquo;t. This is the actual kit I reach for in 2026 — not a list of things I&rsquo;ve heard of. Inspired by Wes Bos&rsquo; <a href="https://uses.tech" class="accent-underline text-ink" target="_blank" rel="noopener">uses.tech</a>.
      </p>
    </div>
  </section>

  {groups.map((group, gi) => (
    <section class:list={["px-6 py-8 md:px-10 md:py-12", gi % 2 === 1 && "border-y border-line bg-bg-elevated"]}>
      <div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-12 md:gap-10">
        <div class="md:col-span-4">
          <p class="text-[11px] uppercase tracking-[0.18em] text-ink-subtle">
            {String(gi + 1).padStart(2, "0")} — {group.title}
          </p>
          <h2 class="mt-3 font-display text-xl font-medium tracking-tight text-ink md:text-2xl">
            {group.title}.
          </h2>
        </div>
        <ul class="md:col-span-8 md:divide-y md:divide-line">
          {group.items.map((it, i) => (
            <li class:list={["reveal grid gap-1 py-3 md:grid-cols-12 md:gap-5", i === 0 && "md:pt-0"]}>
              <p class="font-display text-base text-ink md:col-span-4 md:text-lg">{it.name}</p>
              <p class="text-[13px] leading-relaxed text-ink-muted md:col-span-8">{it.note}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <!-- Closing -->
  <section class="px-6 py-12 md:px-10 md:py-16">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-[11px] uppercase tracking-[0.18em] text-ink-subtle">Missing something?</p>
      <h2 class="mt-3 font-display text-2xl font-medium tracking-tight text-ink md:text-3xl">
        Ask me.
      </h2>
      <p class="mt-4 text-[15px] leading-relaxed text-ink-muted">
        Half of what I use isn&rsquo;t on this page yet. Send a note if you want my take on a tool — I&rsquo;ll tell you if I&rsquo;ve actually shipped with it.
      </p>
      <a
        href="/contact"
        class="mt-6 inline-flex cursor-pointer items-center gap-2 rounded-full bg-ink px-4 py-2 text-[13px] font-medium text-bg transition-colors hover:bg-accent"
      >
        Send a note
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>
