---
import BaseLayout from "../layouts/BaseLayout.astro";

const updated = "July 22, 2026";

const building = [
  {
    title: "Prof Brug archive",
    body: "Publications + clips CMS for profbrug.org — batch uploads, Cloudflare R2, and a floating pill header. Shipping fixes and imports weekly against the dev branch that deploys the site.",
    tag: "Client",
  },
  {
    title: "BizBridge Ethiopia",
    body: "Frontend on a free biz-setup platform for the diaspora — Turborepo of Next 15 + Payload v3 + Fastify + Drizzle. Paid tier was stripped in July, so the focus is the bilingual 26-sector pilot batch.",
    tag: "Civic",
  },
  {
    title: "This site",
    body: "Keeping the personal site honest — /now page you're reading, a more structural hero, and one writing post in draft. The moment it feels stale, that's the signal to update it.",
    tag: "Meta",
  },
];

const reading = [
  {
    title: "Bleak House",
    by: "Charles Dickens",
    tag: "Fiction",
    note: "Dickens on institutional inertia — a slow, structural read that hits differently when you spend your day untangling client systems.",
  },
  {
    title: "The 3D Gospel: Ministry in Guilt, Shame, and Fear Cultures",
    by: "Jayson Georges",
    tag: "Missiology",
    note: "Three cultural registers for the gospel — guilt, shame, fear. A working frame for Ethiopian context, not just Western contextualization theory.",
  },
  {
    title: "The Pastor as Exegete",
    by: "Goetzinger",
    tag: "Hermeneutics",
    note: "The practical case that exegesis is the pastor's craft, not a scholar's optional add-on. Short, sharp, and impossible to skim honestly.",
  },
  {
    title: "Hermeneutics and the Confessions",
    by: "Tomczak",
    tag: "Confessions",
    note: "How the Lutheran Confessions read Scripture — and why that reading is a working method, not just a historical artifact.",
  },
];

const learning = [
  "React Server Components patterns past the basics",
  "Type-safe i18n for Ge'ez script rendering",
  "Better Astro content collections for archive sites",
];
---

<BaseLayout
  title="Now"
  description="What Cherinet Demeke is working on, reading, and learning — updated monthly."
  current="Now"
>
  <!-- Hero -->
  <section class="relative px-6 pb-12 pt-36 md:px-10 md:pb-20 md:pt-44">
    <div class="mx-auto max-w-6xl">
      <div class="flex items-center gap-2 text-xs uppercase tracking-[0.18em] text-ink-subtle">
        <span class="size-1.5 rounded-full bg-accent"></span>
        <span>Updated {updated}</span>
      </div>
      <h1
        class="mt-6 max-w-4xl font-display font-medium leading-[1.02] tracking-[-0.03em] text-ink"
        style="font-size: var(--text-display-xl);"
      >
        What I&rsquo;m doing
        <span class="italic text-ink-muted">right now.</span>
      </h1>
      <p class="mt-8 max-w-2xl text-lg leading-relaxed text-ink-muted">
        A monthly snapshot — what I&rsquo;m building, reading, and learning. Inspired by Derek Sivers&rsquo; <a href="https://sive.rs/nowff" class="accent-underline text-ink" target="_blank" rel="noopener">/now page movement</a>. If you&rsquo;re reading this more than a month after the date above, ping me — I probably forgot to update it.
      </p>
    </div>
  </section>

  <!-- Building -->
  <section class="px-6 pb-20 md:px-10 md:pb-28">
    <div class="mx-auto max-w-6xl">
      <div class="mb-10 grid gap-2 md:grid-cols-12">
        <p class="text-xs uppercase tracking-[0.18em] text-ink-subtle md:col-span-3">01 — Building</p>
        <h2
          class="font-display font-medium tracking-tight text-ink md:col-span-9"
          style="font-size: var(--text-display-lg);"
        >
          Three things on the bench.
        </h2>
      </div>
      <div class="grid gap-5 md:grid-cols-3 md:gap-6">
        {building.map((b) => (
          <article class="reveal flex flex-col rounded-xl border border-line bg-bg-elevated p-6">
            <p class="text-[10px] uppercase tracking-widest text-ink-subtle">{b.tag}</p>
            <h3 class="mt-4 font-display text-2xl tracking-tight text-ink">{b.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted">{b.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Reading -->
  <section class="border-t border-line bg-bg-elevated px-6 py-20 md:px-10 md:py-28">
    <div class="mx-auto max-w-6xl">
      <div class="mb-10 grid gap-2 md:mb-14 md:grid-cols-12">
        <p class="text-xs uppercase tracking-[0.18em] text-ink-subtle md:col-span-3">02 — Reading</p>
        <div class="md:col-span-9">
          <h2
            class="font-display font-medium tracking-tight text-ink"
            style="font-size: var(--text-display-lg);"
          >
            On the desk.
          </h2>
          <p class="mt-4 max-w-2xl text-sm leading-relaxed text-ink-muted md:text-base">
            The real stack, not a curated one — theology + hermeneutics I&rsquo;m working through, plus one long novel to keep the rhythm honest.
          </p>
        </div>
      </div>
      <ul class="grid gap-5 md:grid-cols-2 md:gap-6">
        {reading.map((r) => (
          <li class="reveal flex flex-col rounded-xl border border-line bg-bg p-6">
            <p class="font-mono text-[10px] uppercase tracking-widest text-ink-subtle">{r.tag}</p>
            <p class="mt-4 font-display text-xl leading-snug tracking-tight text-ink">{r.title}</p>
            <p class="mt-1.5 text-sm text-ink-muted">by {r.by}</p>
            <p class="mt-4 text-sm leading-relaxed text-ink-muted">{r.note}</p>
          </li>
        ))}
      </ul>
      <a href="/reading" class="mt-10 inline-flex items-center gap-1.5 text-sm font-medium text-ink accent-underline">
        Full reading list →
      </a>
    </div>
  </section>

  <!-- Learning -->
  <section class="px-6 py-20 md:px-10 md:py-28">
    <div class="mx-auto max-w-6xl">
      <div class="mb-10 grid gap-2 md:grid-cols-12">
        <p class="text-xs uppercase tracking-[0.18em] text-ink-subtle md:col-span-3">03 — Learning</p>
        <h2
          class="font-display font-medium tracking-tight text-ink md:col-span-9"
          style="font-size: var(--text-display-lg);"
        >
          Sharpening up on.
        </h2>
      </div>
      <ol class="grid gap-5 md:grid-cols-3 md:gap-6">
        {learning.map((l, i) => (
          <li class="reveal flex flex-col rounded-xl border border-line bg-bg-elevated p-6">
            <span class="font-display text-3xl italic text-accent">{String(i + 1).padStart(2, "0")}</span>
            <p class="mt-4 text-base leading-relaxed text-ink">{l}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>
