---
import BaseLayout from "../layouts/BaseLayout.astro";

const updated = "July 22, 2026";

const building = [
  {
    title: "Prof Brug archive",
    body: "Publications + clips CMS for profbrug.org — batch uploads, Cloudflare R2, and a floating pill header. Shipping fixes and imports weekly against the dev branch that deploys the site.",
    tag: "Client",
  },
  {
    title: "BizBridge Ethiopia",
    body: "Frontend on a free biz-setup platform for the diaspora — Turborepo of Next 15 + Payload v3 + Fastify + Drizzle. Paid tier was stripped in July, so the focus is the bilingual 26-sector pilot batch.",
    tag: "Civic",
  },
  {
    title: "This site",
    body: "Keeping the personal site honest — /now page you're reading, a more structural hero, and one writing post in draft. The moment it feels stale, that's the signal to update it.",
    tag: "Meta",
  },
];

const learning = [
  "React Server Components patterns past the basics",
  "Type-safe i18n for Ge'ez script rendering",
  "Better Astro content collections for archive sites",
];
---

<BaseLayout
  title="Now"
  description="What Cherinet Demeke is working on and learning — updated monthly."
  current="Now"
>
  <!-- Hero -->
  <section class="relative px-6 pb-8 pt-28 md:px-10 md:pb-12 md:pt-32">
    <div class="mx-auto max-w-6xl">
      <div class="flex items-center gap-2 text-[11px] uppercase tracking-[0.18em] text-ink-subtle">
        <span class="size-1.5 rounded-full bg-accent"></span>
        <span>Updated {updated}</span>
      </div>
      <h1
        class="mt-4 max-w-4xl font-display font-medium leading-[1.05] tracking-[-0.03em] text-ink"
        style="font-size: var(--text-display-lg);"
      >
        What I&rsquo;m doing
        <span class="italic text-ink-muted">right now.</span>
      </h1>
      <p class="mt-5 max-w-2xl text-[15px] leading-relaxed text-ink-muted">
        A monthly snapshot — what I&rsquo;m building and learning. Inspired by Derek Sivers&rsquo; <a href="https://sive.rs/nowff" class="accent-underline text-ink" target="_blank" rel="noopener">/now page movement</a>. If you&rsquo;re reading this more than a month after the date above, ping me — I probably forgot to update it.
      </p>
    </div>
  </section>

  <!-- Building -->
  <section class="px-6 pb-10 md:px-10 md:pb-14">
    <div class="mx-auto max-w-6xl">
      <div class="mb-5 grid gap-2 md:grid-cols-12">
        <p class="text-[11px] uppercase tracking-[0.18em] text-ink-subtle md:col-span-3">01 — Building</p>
        <h2 class="font-display text-xl font-medium tracking-tight text-ink md:col-span-9 md:text-2xl">
          Three things on the bench.
        </h2>
      </div>
      <div class="grid gap-3 md:grid-cols-3 md:gap-4">
        {building.map((b) => (
          <article class="reveal flex flex-col rounded-lg border border-line bg-bg-elevated p-4">
            <p class="text-[10px] uppercase tracking-widest text-ink-subtle">{b.tag}</p>
            <h3 class="mt-2 font-display text-lg tracking-tight text-ink">{b.title}</h3>
            <p class="mt-1.5 text-[13px] leading-relaxed text-ink-muted">{b.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Learning -->
  <section class="border-t border-line bg-bg-elevated px-6 py-10 md:px-10 md:py-14">
    <div class="mx-auto max-w-6xl">
      <div class="mb-5 grid gap-2 md:grid-cols-12">
        <p class="text-[11px] uppercase tracking-[0.18em] text-ink-subtle md:col-span-3">02 — Learning</p>
        <h2 class="font-display text-xl font-medium tracking-tight text-ink md:col-span-9 md:text-2xl">
          Sharpening up on.
        </h2>
      </div>
      <ol class="grid gap-3 md:grid-cols-3 md:gap-4">
        {learning.map((l, i) => (
          <li class="reveal flex flex-col rounded-lg border border-line bg-bg-elevated p-4">
            <span class="font-display text-xl italic text-accent">{String(i + 1).padStart(2, "0")}</span>
            <p class="mt-2 text-[14px] leading-relaxed text-ink">{l}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>
