---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects, kindLabel, type ProjectKind } from "../../lib/projects";

const filters: { key: "all" | ProjectKind; label: string }[] = [
  { key: "all", label: "All" },
  { key: "client", label: "Client" },
  { key: "product", label: "Product" },
  { key: "personal", label: "Personal" },
];

const hrefFor = (p: (typeof projects)[number]) =>
  p.caseStudy ? `/work/${p.slug}` : p.live ?? undefined;
---

<BaseLayout title="Work" description="Every project I've designed and built: client work, products and side projects." current="Work">
  <section class="px-6 pb-24 pt-32 md:pt-40">
    <div class="mx-auto max-w-6xl">
      <div class="t-rise flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
        <div>
          <h1 style="--i:0; font-size: clamp(2.75rem, 6vw, 4.75rem);" class="font-display font-medium leading-none tracking-[-0.035em] text-ink">
            Work <sup class="align-super text-[0.35em] font-normal tracking-normal text-ink-subtle">{projects.length}</sup>
          </h1>
          <p style="--i:1" class="mt-4 max-w-md text-lg text-ink-muted">Everything I've designed and built, newest first.</p>
        </div>

        <div style="--i:2" role="tablist" aria-label="Filter projects" data-tabs class="t-tabs inline-flex self-start rounded-full border border-line bg-bg-elevated p-1 md:self-auto">
          <span class="t-tabs-pill" data-pill aria-hidden="true"></span>
          {
            filters.map((f, i) => (
              <button
                type="button"
                role="tab"
                data-filter={f.key}
                aria-selected={i === 0 ? "true" : "false"}
                class="rounded-full px-4 py-2 text-sm text-ink-muted transition-colors duration-200 hover:text-ink"
              >
                {f.label}
              </button>
            ))
          }
        </div>
      </div>

      <ul class="mt-14 border-t border-line" data-list>
        {
          projects.map((p) => {
            const href = hrefFor(p);
            const external = href?.startsWith("http");
            const Tag = href ? "a" : "div";
            return (
              <li data-row data-kind={p.kind} class="border-b border-line">
                <Tag
                  {...(href ? { href } : {})}
                  {...(external ? { target: "_blank", rel: "noopener" } : {})}
                  data-preview={p.image ? p.slug : undefined}
                  class:list={[
                    "group grid grid-cols-[1fr_auto] items-center gap-x-6 gap-y-1 py-6 md:grid-cols-[6rem_1.3fr_1fr_7rem_1.5rem]",
                    href && "cursor-pointer",
                  ]}
                >
                  <span class="order-3 col-span-2 text-xs tabular-nums text-ink-subtle md:order-none md:col-span-1 md:text-sm">{p.year}</span>
                  <span>
                    <span class="block font-display text-2xl tracking-tight text-ink transition-colors group-hover:text-accent md:text-[1.7rem]">{p.title}</span>
                    <span class="mt-1 block text-sm text-ink-muted">{p.blurb}</span>
                  </span>
                  <span class="hidden text-sm text-ink-subtle md:block">{p.stack.join(" · ")}</span>
                  <span class="justify-self-end md:justify-self-start">
                    {p.status === "building" ? (
                      <span class="inline-flex items-center gap-1.5 rounded-full bg-accent-soft/60 px-2.5 py-1 text-xs text-accent-ink">
                        <span class="size-1.5 animate-pulse rounded-full bg-accent" /> Building
                      </span>
                    ) : (
                      <span class="inline-flex rounded-full border border-line px-2.5 py-1 text-xs text-ink-subtle">{kindLabel[p.kind]}</span>
                    )}
                  </span>
                  <span class="hidden text-ink-subtle md:block" aria-hidden="true">
                    {href && <span class:list={["inline-block group-hover:text-ink", external ? "t-arrow t-arrow-ne" : "t-arrow"]}>{external ? "↗" : "→"}</span>}
                  </span>
                </Tag>
              </li>
            );
          })
        }
      </ul>

      <p class="mt-10 text-sm text-ink-subtle">
        Want the story behind any of these? <a class="underline underline-offset-4 hover:text-ink" href="mailto:cheridemeke7@gmail.com">Just ask</a>.
      </p>
    </div>
  </section>

  <!-- Cursor-follow preview (desktop, fine pointer only) -->
  <div data-preview-box class="pointer-events-none fixed left-0 top-0 z-40 hidden w-80 overflow-hidden rounded-2xl border border-line bg-bg-elevated opacity-0 shadow-2xl shadow-black/25 transition-opacity duration-200 [@media(pointer:fine)]:block" aria-hidden="true">
    {
      projects
        .filter((p) => p.image)
        .map((p) => (
          <Image src={p.image!} alt="" widths={[320, 640]} sizes="320px" data-preview-img={p.slug} class="hidden aspect-[16/10] w-full object-cover object-top" />
        ))
    }
  </div>
</BaseLayout>

<script>
  // ── Sliding filter tabs (transitions.dev "tabs sliding") ──
  const tabs = document.querySelector<HTMLElement>("[data-tabs]");
  const pill = tabs?.querySelector<HTMLElement>("[data-pill]");
  const rows = document.querySelectorAll<HTMLElement>("[data-row]");

  function movePill(btn: HTMLElement, animate = true) {
    if (!pill || !tabs) return;
    if (!animate) pill.style.transition = "none";
    pill.style.width = `${btn.offsetWidth}px`;
    pill.style.transform = `translateX(${btn.offsetLeft}px)`;
    if (!animate) {
      void pill.offsetWidth;
      pill.style.transition = "";
    }
  }

  const buttons = tabs ? Array.from(tabs.querySelectorAll<HTMLButtonElement>("[data-filter]")) : [];
  const first = buttons.find((b) => b.getAttribute("aria-selected") === "true");
  if (first) movePill(first, false);
  window.addEventListener("resize", () => {
    const active = buttons.find((b) => b.getAttribute("aria-selected") === "true");
    if (active) movePill(active, false);
  });

  buttons.forEach((btn) =>
    btn.addEventListener("click", () => {
      buttons.forEach((b) => b.setAttribute("aria-selected", String(b === btn)));
      movePill(btn);
      const key = btn.dataset.filter;
      rows.forEach((r) => (r.hidden = !(key === "all" || r.dataset.kind === key)));
    }),
  );

  // ── Hover preview ──
  const box = document.querySelector<HTMLElement>("[data-preview-box]");
  if (box && matchMedia("(pointer: fine)").matches && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let x = 0, y = 0, cx = 0, cy = 0, raf = 0;
    const loop = () => {
      cx += (x - cx) * 0.18;
      cy += (y - cy) * 0.18;
      box.style.transform = `translate(${cx + 24}px, ${cy - 90}px)`;
      raf = requestAnimationFrame(loop);
    };
    document.querySelectorAll<HTMLElement>("[data-preview]").forEach((el) => {
      el.addEventListener("mouseenter", (e) => {
        const slug = el.dataset.preview;
        box.querySelectorAll<HTMLElement>("[data-preview-img]").forEach((img) => img.classList.toggle("hidden", img.dataset.previewImg !== slug));
        x = cx = e.clientX; y = cy = e.clientY;
        box.style.opacity = "1";
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(loop);
      });
      el.addEventListener("mousemove", (e) => { x = e.clientX; y = e.clientY; });
      el.addEventListener("mouseleave", () => {
        box.style.opacity = "0";
        setTimeout(() => cancelAnimationFrame(raf), 200);
      });
    });
  }
</script>
