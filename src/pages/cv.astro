---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../lib/site";

const experience = [
  {
    org: "Doxa Innovations",
    role: "Co-founder & Senior Frontend Engineer",
    years: "Nov 2024 — now",
    points: [
      "Co-founded the studio and grew it to an 8-person team. I lead frontend architecture, product design and brand.",
      "Ship frontends for US and Ethiopian clients: food commerce, inventory, restaurants, e-commerce.",
      "Set the studio standard: React 19, Next.js 16, strict TypeScript, Tailwind v4, Figma tokens in code.",
    ],
  },
  {
    org: "FIDA Delivery",
    role: "Co-founder, Design & Engineering",
    years: "2025 — now",
    points: [
      "Designed and shipped four production apps: 18+ partners, 500+ deliveries, zero downtime since launch.",
      "Leading the App Store launch and the 1.8.0 Play release (Expo SDK 58 upgrade, iOS and Android redesign).",
      "Built the shared @fida/ui design system used by every surface.",
    ],
  },
  {
    org: "Efuye Gela",
    role: "UI/UX Designer Intern",
    years: "Jun — Sep 2024",
    points: ["Wireframes, user flows and high-fidelity mockups grounded in user research."],
  },
];

const highlights = [
  { name: "Manoli's Provisions", note: "Shop + admin · JS bundle −83%" },
  { name: "Happy Heron Inventory", note: "31-page admin · 400+ tests" },
  { name: "FIDA Delivery", note: "4 apps · 500+ deliveries" },
  { name: "BizBridge Ethiopia", note: "518 sectors · bilingual" },
];

const skills = {
  Frontend: ["TypeScript", "React 19", "Next.js 16", "React Native · Expo", "Svelte 5", "Astro", "Tailwind v4"],
  "UI/UX": ["Figma", "Design systems", "Prototyping", "Motion", "WCAG", "User research"],
  "Growth": ["Technical SEO", "Core Web Vitals", "CRO & A/B tests", "GA4"],
  "Also": ["Laravel", "PostgreSQL", "Docker", "Vitest", "Playwright"],
};

const education = [
  { name: "Bachelor of Arts in Theology", where: "Maor Lutheran Theological Seminary", years: "2020 — 2026" },
  { name: "BA Business Management", where: "Unity University", years: "In progress" },
  { name: "Software Engineering · Cyber Security", where: "ALX Africa", years: "Certificates" },
];
---

<BaseLayout title="CV" description="Cherinet Demeke: senior frontend engineer and product designer. Experience, skills and education." current="CV">
  <section class="px-6 pb-24 pt-32 md:pt-40">
    <div class="mx-auto max-w-4xl">
      <div class="t-rise flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <h1 style="--i:0; font-size: clamp(2.5rem, 5.5vw, 4.25rem);" class="font-display font-medium leading-none tracking-[-0.035em] text-ink">Curriculum vitae</h1>
          <p style="--i:1" class="mt-4 text-ink-muted">{site.role} · {site.location} · Remote</p>
        </div>
        <div style="--i:2" class="flex flex-wrap gap-3 self-start md:self-auto">
          <a href={site.resumePdf} download class="group inline-flex min-h-12 items-center gap-2 rounded-full bg-ink px-6 text-sm font-medium text-bg transition-colors hover:bg-accent">
            Download PDF <span class="t-arrow" aria-hidden="true">↓</span>
          </a>
          <a href={site.resumePdf} target="_blank" rel="noopener" class="inline-flex min-h-12 items-center gap-2 rounded-full border border-line-strong px-6 text-sm font-medium text-ink transition-colors hover:border-ink">
            Open ↗
          </a>
        </div>
      </div>

      <!-- Experience -->
      <h2 class="mt-20 text-xs uppercase tracking-[0.2em] text-ink-subtle">Experience</h2>
      <ol class="mt-4 divide-y divide-line border-y border-line">
        {
          experience.map((e) => (
            <li class="reveal grid gap-4 py-8 md:grid-cols-[1fr_2fr] md:gap-10">
              <div>
                <p class="font-display text-2xl tracking-tight text-ink">{e.org}</p>
                <p class="mt-1 text-sm text-ink-muted">{e.role}</p>
                <p class="mt-1 text-sm tabular-nums text-ink-subtle">{e.years}</p>
              </div>
              <ul class="space-y-2.5 text-ink-muted">
                {e.points.map((pt) => (
                  <li class="flex gap-3"><span class="mt-2.5 size-1 shrink-0 rounded-full bg-accent" />{pt}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>

      <!-- Highlights -->
      <div class="mt-16 flex items-baseline justify-between">
        <h2 class="text-xs uppercase tracking-[0.2em] text-ink-subtle">Project highlights</h2>
        <a href="/work" class="group text-sm text-ink-muted hover:text-ink">All projects <span class="t-arrow inline-block">→</span></a>
      </div>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {
          highlights.map((h) => (
            <li class="reveal rounded-2xl border border-line bg-bg-elevated p-5">
              <p class="font-display text-xl tracking-tight text-ink">{h.name}</p>
              <p class="mt-1 text-sm text-ink-muted">{h.note}</p>
            </li>
          ))
        }
      </ul>

      <!-- Skills -->
      <h2 class="mt-16 text-xs uppercase tracking-[0.2em] text-ink-subtle">Skills</h2>
      <dl class="mt-4 divide-y divide-line border-y border-line">
        {
          Object.entries(skills).map(([group, items]) => (
            <div class="reveal grid gap-3 py-5 md:grid-cols-[1fr_2fr] md:gap-10">
              <dt class="font-display text-lg text-ink">{group}</dt>
              <dd class="flex flex-wrap gap-2">
                {items.map((s) => <span class="rounded-full border border-line px-3 py-1 text-sm text-ink-muted">{s}</span>)}
              </dd>
            </div>
          ))
        }
      </dl>

      <!-- Education -->
      <h2 class="mt-16 text-xs uppercase tracking-[0.2em] text-ink-subtle">Education</h2>
      <ul class="mt-4 divide-y divide-line border-y border-line">
        {
          education.map((ed) => (
            <li class="reveal flex flex-col gap-1 py-5 md:flex-row md:items-baseline md:justify-between">
              <div>
                <p class="font-display text-lg text-ink">{ed.name}</p>
                <p class="text-sm text-ink-muted">{ed.where}</p>
              </div>
              <p class="text-sm tabular-nums text-ink-subtle">{ed.years}</p>
            </li>
          ))
        }
      </ul>

      <p class="mt-10 text-sm text-ink-subtle">Languages: Amharic (native) · English (advanced) · Afan Oromo (intermediate)</p>
    </div>
  </section>
</BaseLayout>
