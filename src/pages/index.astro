---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import StepGlyph from "../components/StepGlyph.astro";
import { featuredProjects } from "../lib/projects";
import { site } from "../lib/site";

const stack = ["Figma", "React", "Next", "Astro", "RN", "Tailwind", "TypeScript"];

const specGrid = [
  { idx: "01", label: "Co-founder", value: "Doxa · FIDA" },
  { idx: "02", label: "Disciplines", value: "Research · Design · Engineering" },
  { idx: "03", label: "Stack", value: "Figma · React · Next · RN" },
  { idx: "04", label: "Base", value: "Bishoftu · Remote-first" },
];

const loopPhases = [
  { glyph: 2, label: "Discover", note: "Interviews, surveys, competitor maps, heatmaps." },
  { glyph: 3, label: "Strategy", note: "Position. Blue / red ocean. Frame the real constraint." },
  { glyph: 5, label: "Design", note: "Sketch flows, then Figma, then tokens." },
  { glyph: 6, label: "Build", note: "React, Next, React Native, design-in-build." },
  { glyph: 8, label: "Measure", note: "Analytics, SEO, funnel, then reduce." },
];
---

<BaseLayout current="Work">
  <!-- Hero — structural, engineered surface -->
  <section class="hero-surface relative overflow-hidden px-6 pb-16 pt-28 md:px-10 md:pb-24 md:pt-36">
    <!-- Corner registration marks -->
    <span class="hero-tick hero-tick--tl" aria-hidden="true"></span>
    <span class="hero-tick hero-tick--tr" aria-hidden="true"></span>
    <span class="hero-tick hero-tick--bl" aria-hidden="true"></span>
    <span class="hero-tick hero-tick--br" aria-hidden="true"></span>

    <div class="relative mx-auto max-w-6xl">
      <!-- Top spec bar: status · loc · tz · rev -->
      <div class="grid grid-cols-2 items-center gap-y-3 border-b border-line pb-4 font-mono text-[11px] uppercase tracking-[0.14em] text-ink-subtle md:grid-cols-4 md:gap-x-6">
        <div class="flex items-center gap-2">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
          </span>
          <span class="text-ink">Available · Q3&rsquo;26</span>
        </div>
        <div><span class="text-ink-subtle">Loc /</span> <span class="text-ink">Bishoftu 8.75°N</span></div>
        <div><span class="text-ink-subtle">Tz /</span> <span class="text-ink">UTC+3</span></div>
        <div><span class="text-ink-subtle">Rev /</span> <span class="text-ink">v2026.07</span></div>
      </div>

      <div class="mt-12 grid gap-10 md:mt-16 md:grid-cols-12 md:gap-8">
        <!-- LEFT: identity + H1 + copy + CTAs -->
        <div class="md:col-span-8">
          <div class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.16em] text-ink-subtle">
            <span class="rounded-full border border-line bg-bg-elevated px-2.5 py-1 text-ink">00 / Identity</span>
            <span aria-hidden="true">—</span>
            <span>Product · Design · Code</span>
          </div>

          <h1
            class="mt-8 font-display font-medium leading-[1.02] tracking-[-0.028em] text-ink"
            style="font-size: var(--text-display-2xl);"
          >
            Product designer<br />
            <span class="italic text-ink-muted">&amp; frontend</span><br />
            <span class="relative inline-block">
              engineer.
              <span
                class="absolute -bottom-1.5 left-0 h-[5px] w-full rounded-full bg-accent md:-bottom-2 md:h-[7px]"
                aria-hidden="true"></span>
            </span>
          </h1>

          <p class="mt-10 max-w-2xl text-lg leading-relaxed text-ink-muted md:text-xl">
            I run the full UX loop end-to-end — research, strategy, design, build, measure — from one operator. Co-founder of <a
              href="https://github.com/Cherireal7"
              class="accent-underline text-ink"
              >Doxa Innovations</a
            > and <a href="#work" class="accent-underline text-ink">FIDA Delivery</a>. Based in Bishoftu — open to a senior role with full bandwidth.
          </p>

          <div class="mt-10 flex flex-wrap items-center gap-3">
            <a
              href="#work"
              class="inline-flex cursor-pointer items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-bg transition-colors hover:bg-accent"
            >
              See selected work
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M12 5v14M5 12l7 7 7-7"></path>
              </svg>
            </a>
            <a
              href={`mailto:${site.email}`}
              class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-line bg-bg-elevated px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:border-line-strong hover:bg-line/40"
            >
              Email me
            </a>
            <a
              href="/cv"
              class="inline-flex cursor-pointer items-center gap-2 rounded-full px-3 py-2.5 text-sm font-medium text-ink-muted transition-colors hover:text-ink"
            >
              CV →
            </a>
          </div>
        </div>

        <!-- RIGHT: system spec card -->
        <aside class="md:col-span-4">
          <div class="relative h-full rounded-xl border border-line bg-bg-elevated p-6">
            <span class="hero-bracket hero-bracket--tl" aria-hidden="true"></span>
            <span class="hero-bracket hero-bracket--tr" aria-hidden="true"></span>
            <span class="hero-bracket hero-bracket--bl" aria-hidden="true"></span>
            <span class="hero-bracket hero-bracket--br" aria-hidden="true"></span>

            <div class="flex items-center justify-between">
              <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-ink-subtle">System spec</p>
              <span class="font-mono text-[10px] text-ink-subtle">v.01</span>
            </div>

            <dl class="mt-6 space-y-5">
              <div>
                <dt class="font-mono text-[10px] uppercase tracking-widest text-ink-subtle">Role</dt>
                <dd class="mt-1.5 font-display text-lg tracking-tight text-ink">Senior FE + Design</dd>
              </div>
              <div>
                <dt class="font-mono text-[10px] uppercase tracking-widest text-ink-subtle">Stack</dt>
                <dd class="mt-2 flex flex-wrap gap-1.5">
                  {stack.map((s) => (
                    <span class="rounded-md border border-line px-2 py-1 font-mono text-[10px] uppercase tracking-widest text-ink">{s}</span>
                  ))}
                </dd>
              </div>
              <div>
                <dt class="font-mono text-[10px] uppercase tracking-widest text-ink-subtle">Ships to</dt>
                <dd class="mt-1.5 text-sm text-ink">Web · iOS · Android · Print</dd>
              </div>
            </dl>

            <div class="mt-6 border-t border-line pt-4">
              <p class="font-mono text-[10px] uppercase tracking-widest text-ink-subtle">Currently // 2026.07</p>
              <ul class="mt-2.5 space-y-1.5 text-sm text-ink">
                <li class="flex items-center gap-2">
                  <span class="text-accent" aria-hidden="true">▸</span>
                  Prof Brug archive
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-accent" aria-hidden="true">▸</span>
                  BizBridge Ethiopia
                </li>
              </ul>
            </div>
          </div>
        </aside>
      </div>

      <!-- Numbered spec grid (keylined) -->
      <div class="mt-16 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line md:mt-20 md:grid-cols-4">
        {specGrid.map((cell) => (
          <div class="bg-bg p-5">
            <div class="flex items-center justify-between">
              <p class="font-mono text-[10px] uppercase tracking-widest text-ink-subtle">{cell.label}</p>
              <span class="font-mono text-[10px] text-ink-subtle">{cell.idx}</span>
            </div>
            <p class="mt-3 font-display text-base leading-snug tracking-tight text-ink md:text-lg">{cell.value}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Approach loop -->
  <section class="border-y border-line bg-bg-elevated px-6 py-16 md:px-10 md:py-20">
    <div class="mx-auto max-w-6xl">
      <div class="reveal mb-12 grid gap-6 md:mb-16 md:grid-cols-12 md:items-end">
        <div class="md:col-span-7">
          <p class="text-xs uppercase tracking-[0.18em] text-ink-subtle">01 — Approach</p>
          <h2
            class="mt-4 font-display font-medium tracking-tight text-ink"
            style="font-size: var(--text-display-lg);"
          >
            UX is the whole loop —
            <span class="italic text-ink-muted">not just the screen.</span>
          </h2>
        </div>
        <p class="text-base leading-relaxed text-ink-muted md:col-span-5">
          Most teams call a Figma file "UX." I think UX starts at the customer interview and ends at the funnel report. I run every phase — research and competitor analysis to design system to React Native to SEO and growth — from one operator.
        </p>
      </div>

      <ol class="grid gap-4 md:grid-cols-5 md:gap-5">
        {loopPhases.map((p, i) => (
          <li class="reveal relative flex flex-col rounded-xl border border-line bg-bg p-5 md:p-6" style={`transition-delay: ${i * 80}ms;`}>
            <div class="flex items-center justify-between">
              <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-line">
                <StepGlyph step={p.glyph} size={28} />
              </div>
              <span class="font-mono text-[11px] text-ink-subtle">0{i + 1}</span>
            </div>
            <p class="mt-5 font-display text-xl tracking-tight text-ink">{p.label}.</p>
            <p class="mt-2 text-[13px] leading-relaxed text-ink-muted">{p.note}</p>
            {i < loopPhases.length - 1 && (
              <span class="absolute right-[-12px] top-1/2 hidden h-px w-6 -translate-y-1/2 bg-line-strong md:block" aria-hidden="true"></span>
            )}
          </li>
        ))}
      </ol>

      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href="/how-i-work" class="inline-flex items-center gap-1.5 text-sm font-medium text-ink accent-underline">
          Read the full process →
        </a>
        <a href="/system" class="text-sm text-ink-muted accent-underline hover:text-ink">
          Or the design system →
        </a>
      </div>
    </div>
  </section>

  <!-- Selected work -->
  <section id="work" class="scroll-mt-28 px-6 pb-16 pt-16 md:px-10 md:pb-24 md:pt-20">
    <div class="mx-auto max-w-6xl">
      <div class="reveal mb-10 flex items-end justify-between gap-6 md:mb-14">
        <div>
          <p class="text-xs uppercase tracking-[0.18em] text-ink-subtle">
            02 — Selected work
          </p>
          <h2
            class="mt-4 font-display font-medium tracking-tight text-ink"
            style="font-size: var(--text-display-lg);"
          >
            Things I&rsquo;ve shipped.
          </h2>
          <p class="mt-4 max-w-2xl text-sm leading-relaxed text-ink-muted md:text-base">
            Badges reflect real deployment state. <span class="text-accent">Live</span> means the product is in production for its users. <span class="text-amber-700 dark:text-amber-300">In development</span> and <span class="text-violet-700 dark:text-violet-300">Private beta</span> mean shipping is underway or gated to invited users — dates like &ldquo;2025 &mdash; present&rdquo; are ongoing engagements, not projections.
          </p>
        </div>
        <a
          href="/work"
          class="hidden shrink-0 text-sm font-medium text-ink-muted accent-underline hover:text-ink md:inline-block"
        >
          View all →
        </a>
      </div>

      <div class="grid items-start gap-5 md:grid-cols-2 md:gap-6">
        {featuredProjects.map((p, i) => <ProjectCard project={p} index={i} />)}
      </div>
    </div>
  </section>

  <!-- About preview -->
  <section class="border-t border-line bg-bg-elevated px-6 py-16 md:px-10 md:py-24">
    <div class="mx-auto grid max-w-6xl gap-12 md:grid-cols-12">
      <div class="md:col-span-4">
        <p class="text-xs uppercase tracking-[0.18em] text-ink-subtle">03 — About</p>
      </div>
      <div class="reveal md:col-span-8">
        <p
          class="font-display font-medium leading-tight tracking-tight text-ink"
          style="font-size: var(--text-display-lg);"
        >
          I lead design systems —
          <span class="text-ink-subtle">then I build them.</span>
        </p>
        <p class="mt-8 max-w-2xl text-lg leading-relaxed text-ink-muted">
          My path runs operations → UI/UX → product engineering. I started in systems
          implementation — rolling out a school management platform across two campuses —
          and grew into frontend leadership through a UI/UX internship and a
          digital-content role with a measurable revenue lift.
        </p>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-muted">
          Today I lead frontend architecture at Doxa Innovations, ship FIDA on the side,
          and work directly with business owners and NGO leadership to turn vague
          requirements into shipped product.
        </p>
        <a
          href="/about"
          class="mt-10 inline-flex items-center gap-1.5 text-sm font-medium text-ink accent-underline"
        >
          More about me →
        </a>
      </div>
    </div>
  </section>

  <!-- Endorsements / references -->
  <section class="border-t border-line px-6 py-16 md:px-10 md:py-24" aria-labelledby="endorsements-heading">
    <div class="mx-auto max-w-6xl">
      <div class="reveal mb-10 md:mb-14">
        <p class="text-xs uppercase tracking-[0.18em] text-ink-subtle">
          04 — Endorsements
        </p>
        <h2
          id="endorsements-heading"
          class="mt-4 max-w-3xl font-display font-medium tracking-tight text-ink"
          style="font-size: var(--text-display-lg);"
        >
          Built alongside
          <span class="italic text-ink-muted">operators who ship.</span>
        </h2>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-muted">
          The people and teams I&rsquo;ve co-founded with, delivered for, and been trusted by across Ethiopia and the US. References available on request &mdash; drop me a note and I&rsquo;ll connect you.
        </p>
      </div>

      <ul class="reveal grid gap-4 sm:grid-cols-2 md:grid-cols-3">
        <li class="rounded-xl border border-line bg-bg-elevated p-6">
          <p class="text-xs uppercase tracking-widest text-ink-subtle">Co-founder team</p>
          <p class="mt-3 font-display text-lg tracking-tight text-ink">Doxa Innovations</p>
          <p class="mt-2 text-sm leading-relaxed text-ink-muted">
            Software studio co-founded with Ephrem Kebede Getachew (Manager) and Gedion Girma (Lead Dev). Eight client projects shipped since 2024.
          </p>
        </li>
        <li class="rounded-xl border border-line bg-bg-elevated p-6">
          <p class="text-xs uppercase tracking-widest text-ink-subtle">Product co-founder</p>
          <p class="mt-3 font-display text-lg tracking-tight text-ink">FIDA Delivery</p>
          <p class="mt-2 text-sm leading-relaxed text-ink-muted">
            Two production React Native apps, one shared backend, and a marketing site &mdash; owned end-to-end alongside the operations team in Bishoftu.
          </p>
        </li>
        <li class="rounded-xl border border-line bg-bg-elevated p-6">
          <p class="text-xs uppercase tracking-widest text-ink-subtle">Client · US</p>
          <p class="mt-3 font-display text-lg tracking-tight text-ink">KLA Construction Equipment</p>
          <p class="mt-2 text-sm leading-relaxed text-ink-muted">
            Korry Ardell&rsquo;s Midwest heavy-equipment dealer. Lead design, brand, and frontend for a Laravel + Inertia storefront with a live eBay catalog sync.
          </p>
        </li>
        <li class="rounded-xl border border-line bg-bg-elevated p-6">
          <p class="text-xs uppercase tracking-widest text-ink-subtle">Client · mission</p>
          <p class="mt-3 font-display text-lg tracking-tight text-ink">Lutheran Heritage Foundation</p>
          <p class="mt-2 text-sm leading-relaxed text-ink-muted">
            Regional site + CMS for LHF Ethiopia &mdash; the LCMS Recognized Service Organization publishing in six Ethiopian languages.
          </p>
        </li>
        <li class="rounded-xl border border-line bg-bg-elevated p-6">
          <p class="text-xs uppercase tracking-widest text-ink-subtle">Client · SMB</p>
          <p class="mt-3 font-display text-lg tracking-tight text-ink">Classic Noodle &amp; Burger</p>
          <p class="mt-2 text-sm leading-relaxed text-ink-muted">
            Bishoftu restaurant. Digital touchpoints, content strategy, and analytics &mdash; grew online orders by 40% year over year.
          </p>
        </li>
        <li class="rounded-xl border border-line bg-bg-elevated p-6">
          <p class="text-xs uppercase tracking-widest text-ink-subtle">Client · civic</p>
          <p class="mt-3 font-display text-lg tracking-tight text-ink">BizBridge Ethiopia</p>
          <p class="mt-2 text-sm leading-relaxed text-ink-muted">
            Freemium business-setup platform. Frontend lead across a Next.js 15 + Payload v3 Turborepo covering 519 licensed sectors.
          </p>
        </li>
      </ul>

      <p class="reveal mt-10 text-sm text-ink-muted">
        Prefer a direct intro?
        <a href="/contact" class="text-ink accent-underline">Ask for references</a>
        and I&rsquo;ll connect you with the right person.
      </p>
    </div>
  </section>

  <!-- Contact strip -->
  <section class="px-6 py-16 md:px-10 md:py-24">
    <div class="mx-auto max-w-6xl">
      <p class="text-xs uppercase tracking-[0.18em] text-ink-subtle">05 — Get in touch</p>
      <h2
        class="reveal mt-4 max-w-3xl font-display font-medium leading-[0.95] tracking-[-0.025em] text-ink"
        style="font-size: var(--text-display-xl);"
      >
        Ready to discuss a role, a new project, or just have a question?
        <a
          href={`mailto:${site.email}`}
          class="text-accent accent-underline"
          style="background-size: 100% 4px;"
        >
          Reach out directly via email.
        </a>
      </h2>
      <p class="reveal mt-6 max-w-2xl text-base text-ink-muted md:text-lg">
        Write to <a href={`mailto:${site.email}`} class="text-ink accent-underline">{site.email}</a> — most replies come back within two working days.
      </p>

      <div class="mt-12 grid gap-6 border-t border-line pt-8 md:grid-cols-3">
        <div>
          <p class="text-xs uppercase tracking-widest text-ink-subtle">Email</p>
          <a
            href={`mailto:${site.email}`}
            class="mt-2 block text-base text-ink hover:text-accent"
            >{site.email}</a
          >
        </div>
        <div>
          <p class="text-xs uppercase tracking-widest text-ink-subtle">GitHub</p>
          <a
            href={site.social.github.href}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-2 block text-base text-ink hover:text-accent">@Cherireal7 ↗</a
          >
        </div>
        <div>
          <p class="text-xs uppercase tracking-widest text-ink-subtle">LinkedIn</p>
          <a
            href={site.social.linkedin.href}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-2 block text-base text-ink hover:text-accent">cherinet-Demeke ↗</a
          >
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
