---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../lib/site";
import { featuredProjects, buildingNow } from "../lib/projects";
import screenHome from "../assets/work/screens/home.png";
import screenGroceries from "../assets/work/screens/browse-groceries.png";
import screenPharmacy from "../assets/work/screens/browse-pharmacy.png";

const [lead, ...rest] = featuredProjects;


const experience = [
  { role: "Co-founder & Senior Frontend Engineer", org: "Doxa Innovations", years: "2024 — now" },
  { role: "Co-founder, Design & Engineering", org: "FIDA Delivery", years: "2025 — now" },
  { role: "UI/UX Designer Intern", org: "Efuye Gela", years: "2024" },
];

const strengths = ["UI/UX", "Design systems", "React · Next.js", "React Native", "SEO", "Conversion"];
---

<BaseLayout>
  <!-- ─── Hero ─── -->
  <section class="px-6 pb-16 pt-28 md:pb-24 md:pt-36">
    <div class="mx-auto grid max-w-6xl items-end gap-12 lg:grid-cols-[1fr_1.05fr] lg:gap-16">
      <div class="t-rise lg:pb-10">
        <p style="--i:0" class="text-sm text-ink-subtle">Senior frontend engineer · Product designer</p>

        <h1 style="--i:1; font-size: clamp(3rem, 8vw, 6.25rem);" class="mt-4 font-display font-medium leading-[0.92] tracking-[-0.045em] text-ink">
          Cherinet<br />Demeke
        </h1>

        <p style="--i:2" class="mt-8 max-w-md text-pretty text-lg leading-relaxed text-ink-muted">
          I co-founded <a href="/work/fida-delivery" class="text-ink underline decoration-line-strong underline-offset-4 hover:decoration-accent">FIDA&nbsp;Delivery</a> and lead frontend at <a href="/work/doxa" class="text-ink underline decoration-line-strong underline-offset-4 hover:decoration-accent">Doxa&nbsp;Innovations</a>, designing and building products for clients in the US and Ethiopia.
        </p>

        <div style="--i:3" class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/work" class="group inline-flex min-h-12 items-center gap-2 rounded-full bg-ink px-6 text-sm font-medium text-bg transition-colors hover:bg-accent">
            View work <span class="t-arrow" aria-hidden="true">→</span>
          </a>
          <a href={site.resumePdf} target="_blank" rel="noopener" class="group inline-flex min-h-12 items-center gap-2 rounded-full border border-line-strong px-6 text-sm font-medium text-ink transition-colors hover:border-ink">
            Resume <span class="text-ink-subtle">PDF</span> <span class="t-arrow t-arrow-ne" aria-hidden="true">↗</span>
          </a>
          <a href="#about" data-intro-jump class="group inline-flex min-h-12 items-center gap-2.5 px-2 text-sm font-medium text-ink-muted transition-colors hover:text-ink">
            <span class="inline-flex size-8 items-center justify-center rounded-full border border-line-strong transition-colors group-hover:border-ink" aria-hidden="true">
              <svg viewBox="0 0 12 12" class="ml-0.5 size-3" fill="currentColor"><path d="M2.5 1.2v9.6L10.5 6z" /></svg>
            </span>
            Meet me in 55 seconds
          </a>
        </div>

        <dl style="--i:4" class="mt-12 max-w-md border-t border-line pt-5 text-sm">
          <dt class="text-ink-subtle">Currently</dt>
          <dd class="mt-1.5 text-ink-muted">Taking FIDA to the App Store, and building Manoli's Provisions for its November launch. Open to senior frontend roles, remote.</dd>
        </dl>
      </div>

      <!-- Real product, no mockup: the FIDA customer app -->
      <figure class="reveal -mx-6 lg:mx-0">
        <div class="flex snap-x snap-mandatory gap-3 overflow-x-auto px-6 pb-2 [scrollbar-width:none] sm:gap-4 lg:overflow-visible lg:px-0">
          {
            [
              { src: screenHome, alt: "FIDA app home: delivery location, categories and a featured restaurant", offset: "lg:translate-y-10" },
              { src: screenGroceries, alt: "FIDA app groceries: category chips and most-wanted items priced in birr", offset: "" },
              { src: screenPharmacy, alt: "FIDA app pharmacy: most-wanted items from a local pharmacy", offset: "lg:-translate-y-8" },
            ].map((s) => (
              <div class:list={["w-[58%] shrink-0 snap-center overflow-hidden rounded-[22px] border border-line bg-white sm:w-[40%] lg:w-1/3 lg:shrink", s.offset]}>
                <Image src={s.src} alt={s.alt} widths={[240, 360, 480]} sizes="(min-width: 1024px) 190px, 58vw" loading="eager" class="block aspect-[720/1300] w-full object-cover object-top" />
              </div>
            ))
          }
        </div>
        <figcaption class="mt-4 flex justify-between gap-4 px-6 text-xs text-ink-subtle lg:mt-12 lg:px-0">
          <span>FIDA customer app · React Native</span>
          <span>Live in Bishoftu</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ─── Selected work ─── -->
  <section id="work" class="px-6 py-20 md:py-28">
    <div class="mx-auto max-w-6xl">
      <div class="flex items-end justify-between gap-6">
        <h2 class="font-display font-medium tracking-[-0.03em] text-ink" style="font-size: var(--text-display-xl);">Selected work</h2>
        <a href="/work" class="group mb-2 inline-flex items-center gap-1.5 text-sm text-ink-muted hover:text-ink">
          All projects <span class="t-arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Lead project -->
      {lead && (
        <a href={`/work/${lead.slug}`} class="reveal group t-lift mt-10 grid overflow-hidden rounded-[28px] border border-line bg-bg-elevated md:grid-cols-[1.4fr_1fr]">
          <div class="overflow-hidden bg-white">
            {lead.image && <Image src={lead.image} alt={`${lead.title} key visual`} widths={[640, 960, 1280]} sizes="(min-width: 768px) 60vw, 100vw" class="t-zoom h-full w-full object-cover" />}
          </div>
          <div class="flex flex-col justify-between gap-8 p-8 md:p-10">
            <div>
              <p class="text-xs uppercase tracking-[0.18em] text-accent">{lead.context}</p>
              <h3 class="mt-3 font-display text-3xl tracking-tight text-ink md:text-4xl">{lead.title}</h3>
              <p class="mt-3 text-pretty text-ink-muted">{lead.blurb}</p>
            </div>
            <div class="flex items-center justify-between gap-4">
              <span class="font-display text-lg text-ink">{lead.metric}</span>
              <span class="t-arrow inline-flex size-11 items-center justify-center rounded-full bg-ink text-bg" aria-hidden="true">→</span>
            </div>
          </div>
        </a>
      )}

      <div class="mt-6 grid gap-6 md:grid-cols-2">
        {
          rest.map((p) => (
            <a href={`/work/${p.slug}`} class="reveal group t-lift flex flex-col overflow-hidden rounded-[28px] border border-line bg-bg-elevated">
              <div class="aspect-[16/10] overflow-hidden">
                {p.image && <Image src={p.image} alt={`${p.title} homepage`} widths={[560, 840, 1120]} sizes="(min-width: 768px) 45vw, 100vw" class="t-zoom h-full w-full object-cover object-top" />}
              </div>
              <div class="flex flex-1 items-end justify-between gap-4 p-7">
                <div>
                  <p class="text-xs uppercase tracking-[0.18em] text-ink-subtle">{p.context}</p>
                  <h3 class="mt-2 font-display text-2xl tracking-tight text-ink">{p.title}</h3>
                  <p class="mt-1.5 text-sm text-ink-muted">{p.blurb}</p>
                </div>
                <span class="t-arrow shrink-0 text-xl text-ink-subtle group-hover:text-ink" aria-hidden="true">→</span>
              </div>
            </a>
          ))
        }
      </div>

      <!-- Now building -->
      <div class="reveal mt-6 rounded-[28px] border border-dashed border-line-strong p-6 md:p-8">
        <p class="flex items-center gap-2 text-xs uppercase tracking-[0.18em] text-ink-subtle">
          Building now
        </p>
        <ul class="mt-5 grid gap-4 md:grid-cols-3">
          {
            buildingNow.map((p) => (
              <li class="rounded-2xl bg-bg-elevated p-5">
                <p class="font-display text-xl tracking-tight text-ink">{p.title}</p>
                <p class="mt-1 text-sm text-ink-muted">{p.blurb}</p>
                {p.metric && <p class="mt-3 text-xs font-medium text-accent">{p.metric}</p>}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ─── About + experience ─── -->
  <section id="about" class="border-y border-line bg-bg-elevated px-6 py-20 md:py-28">
    <div class="mx-auto grid max-w-6xl gap-14 md:grid-cols-2 md:gap-x-16 lg:grid-cols-[17.5rem_1fr_1fr] lg:gap-x-14">
      <!-- A short introduction in his own words -->
      <figure class="reveal order-2 mx-auto w-full max-w-[17.5rem] md:order-none md:row-span-2 lg:row-span-1">
        <div data-intro class="group relative overflow-hidden rounded-[28px] border border-line bg-ink">
          <video
            class="block aspect-[9/16] w-full object-cover"
            src="/intro/cherinet-intro.mp4"
            poster="/intro/cherinet-intro-poster.jpg"
            preload="none"
            playsinline
            aria-label="A 55-second introduction to Cherinet: who he is, what he builds and what he cares about. The narration is captioned on screen."
          ></video>
          <button type="button" data-intro-play class="absolute inset-0 flex items-end justify-start bg-gradient-to-t from-black/55 via-black/0 to-black/0 p-5 text-left text-white transition-opacity">
            <span class="inline-flex items-center gap-3">
              <span class="inline-flex size-12 items-center justify-center rounded-full bg-white text-black transition-transform group-hover:scale-105" aria-hidden="true">
                <svg viewBox="0 0 12 12" class="ml-0.5 size-4" fill="currentColor"><path d="M2.5 1.2v9.6L10.5 6z" /></svg>
              </span>
              <span class="text-sm font-medium leading-tight">Play intro<br /><span class="font-normal text-white/75">55 seconds, with sound</span></span>
            </span>
          </button>
        </div>
        <figcaption class="mt-3 text-center text-xs text-ink-subtle">Made with my own video tools.</figcaption>
      </figure>

      <div class="reveal order-1 md:order-none">
        <h2 class="text-balance font-display font-medium tracking-[-0.03em] text-ink" style="font-size: var(--text-display-xl);">
          Design and code,<br class="hidden sm:block" /> from one person.
        </h2>
        <p class="mt-6 max-w-md text-pretty text-lg leading-relaxed text-ink-muted">
          I co-founded two companies and lead their frontends. I care about the numbers behind the pixels: SEO, conversion, speed.
        </p>
        <ul class="mt-8 flex max-w-md flex-wrap gap-2">
          {strengths.map((s) => <li class="rounded-full border border-line px-3.5 py-1.5 text-sm text-ink">{s}</li>)}
        </ul>
      </div>

      <div class="reveal order-3 md:order-none">
        <ol class="divide-y divide-line border-y border-line">
          {
            experience.map((e) => (
              <li class="flex items-baseline justify-between gap-6 py-5">
                <div>
                  <p class="font-display text-xl tracking-tight text-ink">{e.org}</p>
                  <p class="mt-0.5 text-sm text-ink-muted">{e.role}</p>
                </div>
                <p class="shrink-0 text-sm tabular-nums text-ink-subtle">{e.years}</p>
              </li>
            ))
          }
          <li class="flex items-baseline justify-between gap-6 py-5">
            <div>
              <p class="font-display text-xl tracking-tight text-ink">Education</p>
              <p class="mt-0.5 text-sm text-ink-muted">BA Theology · BA Business Mgmt (in progress) · ALX Software Engineering</p>
            </div>
          </li>
        </ol>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/cv" class="group inline-flex items-center gap-2 rounded-full bg-ink px-5 py-3 text-sm font-medium text-bg transition-colors hover:bg-accent">
            Full CV <span class="t-arrow" aria-hidden="true">→</span>
          </a>
          <a href={site.resumePdf} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full border border-line-strong px-5 py-3 text-sm font-medium text-ink transition-colors hover:border-ink">
            Resume PDF ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Contact ─── -->
  <section id="contact" class="px-6 py-24 md:py-32">
    <div class="reveal mx-auto max-w-6xl text-center">
      <h2 class="mx-auto max-w-3xl text-balance font-display font-medium leading-[1.02] tracking-[-0.035em] text-ink" style="font-size: clamp(2.5rem, 6vw, 4.75rem);">
        Have a role or a project?<br /><span class="text-ink-subtle">Let's talk.</span>
      </h2>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <a href={`mailto:${site.email}`} class="group inline-flex max-w-full items-center gap-2 rounded-full bg-ink px-6 py-4 text-sm font-medium text-bg transition-colors hover:bg-accent sm:px-7 sm:text-base">
          <span class="truncate">{site.email}</span> <span class="t-arrow" aria-hidden="true">→</span>
        </a>
        <button type="button" data-copy={site.email} class="rounded-full border border-line-strong px-5 py-4 text-sm text-ink transition-colors hover:border-ink">
          <span data-copy-label>Copy</span>
        </button>
      </div>
      <p class="mt-6 text-sm text-ink-subtle">
        <a class="hover:text-ink" href={site.social.linkedin.href} rel="noopener">LinkedIn ↗</a>
        <span class="mx-3">·</span>
        <a class="hover:text-ink" href={site.social.github.href} rel="noopener">GitHub ↗</a>
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  // Intro video: the poster and a play button first; the file loads only when asked for.
  const intro = document.querySelector<HTMLElement>("[data-intro]");
  const introVideo = intro?.querySelector("video");
  const introPlay = intro?.querySelector<HTMLButtonElement>("[data-intro-play]");
  function playIntro() {
    if (!introVideo || !introPlay) return;
    introPlay.hidden = true;
    introVideo.controls = true;
    void introVideo.play().catch(() => {});
    introVideo.focus();
  }
  introPlay?.addEventListener("click", playIntro);
  introVideo?.addEventListener("ended", () => {
    if (!introPlay) return;
    introVideo.controls = false;
    introVideo.load();
    introPlay.hidden = false;
  });
  document.querySelector("[data-intro-jump]")?.addEventListener("click", (event) => {
    event.preventDefault();
    intro?.scrollIntoView({ behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "center" });
    playIntro();
  });

  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const label = btn.querySelector("[data-copy-label]");
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        if (label) label.textContent = "Copied ✓";
      } catch {
        if (label) label.textContent = "Press ⌘C";
      }
      setTimeout(() => label && (label.textContent = "Copy"), 1800);
    });
  });
</script>
