---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../lib/site";
import { featuredProjects, buildingNow } from "../lib/projects";
import fidaTma from "../assets/work/fida-tma.png";
import fidaMap from "../assets/work/fida-map.png";

const [lead, ...rest] = featuredProjects;

const stats = [
  { value: "500+", label: "deliveries on FIDA" },
  { value: "8+", label: "client projects" },
  { value: "4", label: "production apps" },
];

const experience = [
  { role: "Co-founder & Senior Frontend Engineer", org: "Doxa Innovations", years: "2024 — now" },
  { role: "Co-founder, Design & Engineering", org: "FIDA Delivery", years: "2025 — now" },
  { role: "UI/UX Designer Intern", org: "Efuye Gela", years: "2024" },
];

const strengths = ["UI/UX", "Design systems", "React · Next.js", "React Native", "SEO", "Conversion"];
---

<BaseLayout>
  <!-- ─── Hero ─── -->
  <section class="grain relative overflow-hidden px-6 pb-20 pt-32 md:pb-28 md:pt-40">
    <div class="mx-auto grid max-w-6xl items-center gap-14 lg:grid-cols-[1.15fr_0.85fr]">
      <div class="t-rise">
        <p style="--i:0" class="inline-flex items-center gap-2 rounded-full border border-line bg-bg-elevated/70 px-3 py-1.5 text-xs text-ink-muted">
          <span class="relative flex size-2">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-500 opacity-60"></span>
            <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
          </span>
          {site.availability}
        </p>

        <h1 style="--i:1; font-size: clamp(2.75rem, 6.5vw, 5.25rem);" class="mt-6 text-balance font-display font-medium leading-[0.98] tracking-[-0.035em] text-ink">
          Frontend engineer<br class="hidden sm:block" /> who <em class="text-accent">designs.</em>
        </h1>

        <p style="--i:2" class="mt-6 max-w-lg text-pretty text-lg leading-relaxed text-ink-muted md:text-xl">
          I take products from Figma to production: fast, accessible and built to convert.
        </p>

        <div style="--i:3" class="mt-9 flex flex-wrap items-center gap-3">
          <a href="/work" class="group inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3.5 text-sm font-medium text-bg transition-colors hover:bg-accent">
            See my work <span class="t-arrow" aria-hidden="true">→</span>
          </a>
          <a href={site.resumePdf} download class="group inline-flex items-center gap-2 rounded-full border border-line-strong px-6 py-3.5 text-sm font-medium text-ink transition-colors hover:border-ink">
            Download CV <span class="t-arrow" aria-hidden="true">↓</span>
          </a>
        </div>

        <dl style="--i:4" class="mt-14 grid max-w-md grid-cols-3 gap-6 border-t border-line pt-6">
          {
            stats.map((s) => (
              <div>
                <dt class="sr-only">{s.label}</dt>
                <dd class="font-display text-3xl tracking-tight text-ink md:text-4xl">{s.value}</dd>
                <dd class="mt-1 text-xs leading-snug text-ink-subtle">{s.label}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- Visual collage -->
      <div class="relative mx-auto hidden aspect-[4/5] w-full max-w-md lg:block" aria-hidden="true">
        <div class="absolute right-0 top-0 w-[78%] rotate-[4deg] overflow-hidden rounded-[28px] border border-line shadow-2xl shadow-black/20">
          <Image src={fidaTma} alt="" widths={[420, 640]} sizes="360px" loading="eager" class="block h-auto w-full" />
        </div>
        <div class="absolute bottom-6 left-0 w-[70%] -rotate-[5deg] overflow-hidden rounded-[22px] border border-line bg-bg-elevated shadow-2xl shadow-black/20">
          <Image src={fidaMap} alt="" widths={[420, 640]} sizes="320px" loading="eager" class="block h-auto w-full" />
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Selected work ─── -->
  <section id="work" class="px-6 py-20 md:py-28">
    <div class="mx-auto max-w-6xl">
      <div class="flex items-end justify-between gap-6">
        <h2 class="font-display font-medium tracking-[-0.03em] text-ink" style="font-size: var(--text-display-xl);">Selected work</h2>
        <a href="/work" class="group mb-2 inline-flex items-center gap-1.5 text-sm text-ink-muted hover:text-ink">
          All projects <span class="t-arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Lead project -->
      {lead && (
        <a href={`/work/${lead.slug}`} class="reveal group t-lift mt-10 grid overflow-hidden rounded-[28px] border border-line bg-bg-elevated md:grid-cols-[1.4fr_1fr]">
          <div class="overflow-hidden bg-white">
            {lead.image && <Image src={lead.image} alt={`${lead.title} key visual`} widths={[640, 960, 1280]} sizes="(min-width: 768px) 60vw, 100vw" class="t-zoom h-full w-full object-cover" />}
          </div>
          <div class="flex flex-col justify-between gap-8 p-8 md:p-10">
            <div>
              <p class="text-xs uppercase tracking-[0.18em] text-accent">{lead.context}</p>
              <h3 class="mt-3 font-display text-3xl tracking-tight text-ink md:text-4xl">{lead.title}</h3>
              <p class="mt-3 text-pretty text-ink-muted">{lead.blurb}</p>
            </div>
            <div class="flex items-center justify-between gap-4">
              <span class="font-display text-lg text-ink">{lead.metric}</span>
              <span class="t-arrow inline-flex size-11 items-center justify-center rounded-full bg-ink text-bg" aria-hidden="true">→</span>
            </div>
          </div>
        </a>
      )}

      <div class="mt-6 grid gap-6 md:grid-cols-2">
        {
          rest.map((p) => (
            <a href={`/work/${p.slug}`} class="reveal group t-lift flex flex-col overflow-hidden rounded-[28px] border border-line bg-bg-elevated">
              <div class="aspect-[16/10] overflow-hidden">
                {p.image && <Image src={p.image} alt={`${p.title} homepage`} widths={[560, 840, 1120]} sizes="(min-width: 768px) 45vw, 100vw" class="t-zoom h-full w-full object-cover object-top" />}
              </div>
              <div class="flex flex-1 items-end justify-between gap-4 p-7">
                <div>
                  <p class="text-xs uppercase tracking-[0.18em] text-ink-subtle">{p.context}</p>
                  <h3 class="mt-2 font-display text-2xl tracking-tight text-ink">{p.title}</h3>
                  <p class="mt-1.5 text-sm text-ink-muted">{p.blurb}</p>
                </div>
                <span class="t-arrow shrink-0 text-xl text-ink-subtle group-hover:text-ink" aria-hidden="true">→</span>
              </div>
            </a>
          ))
        }
      </div>

      <!-- Now building -->
      <div class="reveal mt-6 rounded-[28px] border border-dashed border-line-strong p-6 md:p-8">
        <p class="flex items-center gap-2 text-xs uppercase tracking-[0.18em] text-ink-subtle">
          <span class="size-1.5 animate-pulse rounded-full bg-accent"></span> Building now
        </p>
        <ul class="mt-5 grid gap-4 md:grid-cols-3">
          {
            buildingNow.map((p) => (
              <li class="rounded-2xl bg-bg-elevated p-5">
                <p class="font-display text-xl tracking-tight text-ink">{p.title}</p>
                <p class="mt-1 text-sm text-ink-muted">{p.blurb}</p>
                {p.metric && <p class="mt-3 text-xs font-medium text-accent">{p.metric}</p>}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ─── About + experience ─── -->
  <section id="about" class="border-y border-line bg-bg-elevated px-6 py-20 md:py-28">
    <div class="mx-auto grid max-w-6xl gap-14 md:grid-cols-2 md:gap-20">
      <div class="reveal">
        <h2 class="text-balance font-display font-medium tracking-[-0.03em] text-ink" style="font-size: var(--text-display-xl);">
          Design and code, <em class="text-accent">one head.</em>
        </h2>
        <p class="mt-6 max-w-md text-pretty text-lg leading-relaxed text-ink-muted">
          I co-founded two companies and lead their frontends. I care about the numbers behind the pixels: SEO, conversion, speed.
        </p>
        <ul class="mt-8 flex max-w-md flex-wrap gap-2">
          {strengths.map((s) => <li class="rounded-full border border-line px-3.5 py-1.5 text-sm text-ink">{s}</li>)}
        </ul>
      </div>

      <div class="reveal">
        <ol class="divide-y divide-line border-y border-line">
          {
            experience.map((e) => (
              <li class="flex items-baseline justify-between gap-6 py-5">
                <div>
                  <p class="font-display text-xl tracking-tight text-ink">{e.org}</p>
                  <p class="mt-0.5 text-sm text-ink-muted">{e.role}</p>
                </div>
                <p class="shrink-0 text-sm tabular-nums text-ink-subtle">{e.years}</p>
              </li>
            ))
          }
          <li class="flex items-baseline justify-between gap-6 py-5">
            <div>
              <p class="font-display text-xl tracking-tight text-ink">Education</p>
              <p class="mt-0.5 text-sm text-ink-muted">BA Theology · BA Business Mgmt (in progress) · ALX Software Engineering</p>
            </div>
          </li>
        </ol>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/cv" class="group inline-flex items-center gap-2 rounded-full bg-ink px-5 py-3 text-sm font-medium text-bg transition-colors hover:bg-accent">
            Full CV <span class="t-arrow" aria-hidden="true">→</span>
          </a>
          <a href={site.resumePdf} download class="inline-flex items-center gap-2 rounded-full border border-line-strong px-5 py-3 text-sm font-medium text-ink transition-colors hover:border-ink">
            PDF ↓
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Contact ─── -->
  <section id="contact" class="px-6 py-24 md:py-32">
    <div class="reveal mx-auto max-w-6xl text-center">
      <h2 class="mx-auto max-w-3xl text-balance font-display font-medium leading-[1.02] tracking-[-0.035em] text-ink" style="font-size: clamp(2.5rem, 6vw, 4.75rem);">
        Have a role or a project? <em class="text-accent">Let's talk.</em>
      </h2>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <a href={`mailto:${site.email}`} class="group inline-flex items-center gap-2 rounded-full bg-ink px-7 py-4 text-base font-medium text-bg transition-colors hover:bg-accent">
          {site.email} <span class="t-arrow" aria-hidden="true">→</span>
        </a>
        <button type="button" data-copy={site.email} class="rounded-full border border-line-strong px-5 py-4 text-sm text-ink transition-colors hover:border-ink">
          <span data-copy-label>Copy</span>
        </button>
      </div>
      <p class="mt-6 text-sm text-ink-subtle">
        <a class="hover:text-ink" href={site.social.linkedin.href} rel="noopener">LinkedIn ↗</a>
        <span class="mx-3">·</span>
        <a class="hover:text-ink" href={site.social.github.href} rel="noopener">GitHub ↗</a>
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const label = btn.querySelector("[data-copy-label]");
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        if (label) label.textContent = "Copied ✓";
      } catch {
        if (label) label.textContent = "Press ⌘C";
      }
      setTimeout(() => label && (label.textContent = "Copy"), 1800);
    });
  });
</script>
