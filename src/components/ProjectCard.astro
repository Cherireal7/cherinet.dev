---
import type { Project } from "../lib/projects";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;

const href =
  project.status === "case-study"
    ? `/work/${project.slug}`
    : project.status === "external"
      ? project.external
      : undefined;

const Tag = href ? "a" : "div";

const spanClass =
  project.span === "wide"
    ? "md:col-span-2"
    : project.span === "tall"
      ? "md:row-span-2"
      : "";

const accentRail =
  project.accent === "blue"
    ? "bg-accent"
    : "bg-ink";

const isExternal = project.status === "external";

const liveStatusLabel: Record<NonNullable<Project["liveStatus"]>, string> = {
  live: "Live",
  "in-development": "In dev",
  "private-beta": "Beta",
  wip: "Review",
};

const liveStatusStyle: Record<NonNullable<Project["liveStatus"]>, string> = {
  live: "border-accent/40 bg-accent/5 text-accent",
  "in-development": "border-amber-300/50 bg-amber-50/60 text-amber-700 dark:border-amber-400/30 dark:bg-amber-400/10 dark:text-amber-300",
  "private-beta": "border-violet-300/50 bg-violet-50/60 text-violet-700 dark:border-violet-400/30 dark:bg-violet-400/10 dark:text-violet-300",
  wip: "border-line-strong bg-bg text-ink-muted",
};
---

<Tag
  href={href}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
  class:list={[
    "reveal group relative flex flex-col overflow-hidden rounded-lg border border-line bg-bg-elevated p-4 transition-all duration-300 md:p-5",
    href &&
      "cursor-pointer hover:-translate-y-0.5 hover:border-line-strong hover:shadow-[0_12px_28px_-16px_rgb(24,24,27,0.14)]",
    spanClass,
  ]}
  style={`transition-delay: ${index * 40}ms;`}
  aria-label={href ? `${project.title} — ${isExternal ? "visit live site" : "read case study"}` : project.title}
>
  {/* Accent rail — animates on hover */}
  <span
    class:list={[
      "absolute left-0 top-0 h-0.5 w-8 transition-all duration-500 group-hover:w-20",
      accentRail,
    ]}
    aria-hidden="true"
  ></span>

  {/* Top row: year + status */}
  <div class="mb-3 flex items-center justify-between gap-2 text-[10px] uppercase tracking-widest text-ink-subtle">
    <span>{project.year.split(" ")[0]}</span>
    <div class="flex items-center gap-1.5">
      {project.liveStatus && (
        <span class:list={[
          "inline-flex items-center gap-1 rounded-full border px-1.5 py-0.5 font-medium",
          liveStatusStyle[project.liveStatus],
        ]}>
          <span class="size-1 rounded-full bg-current"></span>
          {liveStatusLabel[project.liveStatus]}
        </span>
      )}
      {isExternal && !project.liveStatus && (
        <span class="inline-flex items-center gap-0.5 rounded-full border border-line bg-bg px-1.5 py-0.5 font-medium text-ink">
          Live
          <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17 17 7M9 7h8v8" />
          </svg>
        </span>
      )}
    </div>
  </div>

  {/* Title + metric */}
  <div class="flex items-baseline justify-between gap-3">
    <h3 class="text-base font-medium tracking-tight text-ink md:text-lg">
      {project.title}
    </h3>
    {project.metric && (
      <span class="shrink-0 rounded-full border border-line bg-bg px-2 py-0.5 text-[10px] font-medium text-ink-muted">
        {project.metric}
      </span>
    )}
  </div>

  {/* Subtitle */}
  <p class="mt-1.5 text-[13px] leading-relaxed text-ink-muted md:text-sm">
    {project.subtitle}
  </p>

  {/* Stack chips */}
  <div class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-[10px] uppercase tracking-widest text-ink-subtle">
    {project.stack.slice(0, 4).map((s) => <span>{s}</span>)}
    {project.stack.length > 4 && <span>+{project.stack.length - 4}</span>}
  </div>

  {/* CTA */}
  {href && (
    <div class="mt-3 flex items-center gap-1 text-xs font-medium text-ink-muted transition-colors group-hover:text-accent">
      <span>
        {isExternal ? "Visit live site" : "Read case study"}
      </span>
      <svg
        width="12"
        height="12"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="transition-transform group-hover:translate-x-0.5"
        aria-hidden="true"
      >
        <path d="M5 12h14M13 5l7 7-7 7" />
      </svg>
    </div>
  )}

  {project.status === "placeholder" && (
    <div class="mt-3 text-xs font-medium text-ink-subtle">
      By request →
    </div>
  )}
</Tag>
