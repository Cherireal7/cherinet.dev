---
import ThemeToggle from "./ThemeToggle.astro";
import { site, nav } from "../lib/site";

interface Props {
  current?: string;
}
const { current } = Astro.props;
---

<header class="fixed inset-x-0 top-0 z-50 px-4 pt-4 md:px-6">
  <nav
    data-nav
    aria-label="Main"
    class="mx-auto flex max-w-6xl items-center justify-between rounded-full border border-line/70 bg-bg/75 py-1.5 pl-4 pr-1.5 sm:pl-5 backdrop-blur-xl transition-shadow"
  >
    <a href="/" class="font-display text-lg tracking-tight text-ink" aria-label="Cherinet Demeke, home">
      Cherinet<span class="text-accent">.</span>
    </a>

    <div class="flex items-center gap-0.5 sm:gap-1">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={current === item.label ? "page" : undefined}
            class:list={[
              "rounded-full px-3 py-2.5 text-sm transition-colors",
              current === item.label ? "text-ink" : "text-ink-muted hover:text-ink",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={site.resumePdf}
        target="_blank"
        rel="noopener"
        class="rounded-full px-3 py-2.5 text-sm text-ink-muted transition-colors hover:text-ink"
      >
        Resume<span class="hidden sm:inline"> PDF</span> <span aria-hidden="true">↗</span>
      </a>
      <ThemeToggle />
      <a
        href={`mailto:${site.email}`}
        class="ml-1 hidden rounded-full bg-ink px-4 py-2 text-sm font-medium text-bg transition-colors hover:bg-accent sm:inline-flex"
      >
        Email me
      </a>
    </div>
  </nav>
</header>
