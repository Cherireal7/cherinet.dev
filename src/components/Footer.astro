---
import { site } from "../lib/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-6 py-8 text-sm text-ink-subtle md:flex-row md:items-center md:justify-between">
    <p>© {year} {site.name} · {site.location}</p>
    <ul class="flex flex-wrap gap-x-6 gap-y-2">
      <li><a class="hover:text-ink" href="/work">Work</a></li>
      <li><a class="hover:text-ink" href="/cv">CV</a></li>
      <li><a class="hover:text-ink" href={site.resumePdf} target="_blank" rel="noopener">Resume PDF</a></li>
      <li><a class="hover:text-ink" href={site.social.github.href} rel="noopener">GitHub</a></li>
      <li><a class="hover:text-ink" href={site.social.linkedin.href} rel="noopener">LinkedIn</a></li>
    </ul>
    <p class="font-display italic">Soli Deo gloria.</p>
  </div>
</footer>
